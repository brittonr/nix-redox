# Staged fixtures for guest build-tools parity and capability tests
#
# Provides host-assembled reference artifacts and pinned upstream sources so
# the Redox guest can verify:
# - NASM parity: kernel x86 and x86_64 trampoline.asm -> byte-identical .bin
# - cbindgen parity: relibc headers generated by guest cbindgen vs host cbindgen
# (Python 3 and Perl fixtures are added in Phase 2.)

{
  pkgs,
  kernel-src,
  relibc-src,
}:

pkgs.runCommand "build-tools-test-fixtures"
  {
    nativeBuildInputs = [
      pkgs.coreutils
      pkgs.findutils
      pkgs.gnused
      pkgs.nasm
      pkgs.rust-cbindgen
    ];
  }
  ''
    set -euo pipefail
    mkdir -p "$out/nasm/x86" "$out/nasm/x86_64" "$out/cbindgen/relibc/src" "$out/cbindgen/host-headers"

    # 1. NASM fixture: kernel trampolines + host-assembled reference binaries
    cp "${kernel-src}/src/asm/x86/trampoline.asm" "$out/nasm/x86/trampoline.asm"
    cp "${kernel-src}/src/asm/x86_64/trampoline.asm" "$out/nasm/x86_64/trampoline.asm"
    nasm -f bin -o "$out/nasm/x86/trampoline.host.bin" "$out/nasm/x86/trampoline.asm"
    nasm -f bin -o "$out/nasm/x86_64/trampoline.host.bin" "$out/nasm/x86_64/trampoline.asm"

    # 2. cbindgen fixture: relibc header sources + host-generated reference headers
    cp "${relibc-src}/cbindgen.globdefs.toml" "$out/cbindgen/relibc/cbindgen.globdefs.toml"
    cp -r "${relibc-src}/src/header" "$out/cbindgen/relibc/src/header"
    chmod -R u+w "$out/cbindgen/relibc"

    # Generate host reference headers using the same header set as relibc/Makefile
    (
      cd "$out/cbindgen/relibc"
      headers=$(find src/header -mindepth 1 -maxdepth 1 -type d -not -name "_*" -not -name "math" -printf "%f\n" | sort)
      printf '%s\n' "$headers" > "$out/cbindgen/headers.list"
      for header in $headers; do
        if [ -f "src/header/$header/cbindgen.toml" ]; then
          rel=$(printf '%s\n' "$header" | sed 's/_/\//g')
          target="$out/cbindgen/host-headers/$rel.h"
          mkdir -p "$(dirname "$target")"
          cat "src/header/$header/cbindgen.toml" cbindgen.globdefs.toml > "$TMPDIR/cbindgen.toml"
          cbindgen "src/header/$header/mod.rs" --config "$TMPDIR/cbindgen.toml" --output "$target"
        fi
      done
    )

    # Copy the guest test runner script
    cp "${../../redox-system/test-scripts/build-tools-test.sh}" "$out/run-build-tools-test.sh"
    chmod 755 "$out/run-build-tools-test.sh"
  ''
