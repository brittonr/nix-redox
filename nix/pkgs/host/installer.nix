# Installer - Redox filesystem builder (host tool)
#
# Creates Redox filesystem images from directory trees.
# Runs on the host machine (not cross-compiled).

{
  pkgs,
  lib,
  rustToolchain,
  src,
  ...
}:

let
  # Vendor dependencies
  installerVendor = pkgs.rustPlatform.fetchCargoVendor {
    name = "installer-cargo-vendor";
    inherit src;
    hash = "sha256-xuVC9tn23fQ+eRFJG9C1duHc6giRVcWDGElu3xRz8sg=";
  };

in
pkgs.stdenv.mkDerivation {
  pname = "redox-installer";
  version = "0.2.42";

  inherit src;

  nativeBuildInputs = [
    rustToolchain
    pkgs.pkg-config
    pkgs.perl
  ];

  buildInputs = with pkgs; [
    fuse
    fuse3
  ];

  configurePhase = ''
    runHook preConfigure

    # The upstream ring git source has no pregenerated assembly. Select its
    # documented source-checkout build path and generate assembly with Perl.
    cp -R ${installerVendor} vendor
    chmod -R u+w vendor
    mkdir vendor/source-git-0/ring-0.17.16000/.git

    mkdir -p .cargo
    # Use the cargo config generated by fetchCargoVendor, replacing @vendor@
    sed "s|@vendor@|$PWD/vendor|g" vendor/.cargo/config.toml > .cargo/config.toml
    cat >> .cargo/config.toml << EOF

    [net]
    offline = true
    EOF

    export HOME=$(mktemp -d)

    runHook postConfigure
  '';

  buildPhase = ''
    runHook preBuild

    cargo build --release --locked --offline

    runHook postBuild
  '';

  doCheck = true;

  checkPhase = ''
    runHook preCheck

    cargo test --release --locked --offline

    runHook postCheck
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/bin
    cp target/release/redox_installer $out/bin/
    cp target/release/redox_installer_tui $out/bin/

    runHook postInstall
  '';

  meta = with lib; {
    description = "Redox OS Installer - filesystem image builder";
    homepage = "https://gitlab.redox-os.org/redox-os/installer";
    license = licenses.mit;
    platforms = platforms.linux;
    mainProgram = "redox_installer";
  };
}
