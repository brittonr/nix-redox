Wake the network scheme on RX interrupts using the current per-queue IRQ API.
The virtio-core IRQ thread owns completion draining and interrupt ACKs.

--- a/drivers/net/virtio-netd/src/main.rs
+++ b/drivers/net/virtio-netd/src/main.rs
@@ -2,6 +2,7 @@
 
 use std::fs::File;
 use std::io::{Read, Write};
+use std::os::fd::AsRawFd;
 
 use driver_network::NetworkScheme;
 use pcid_interface::PciFunctionHandle;
@@ -99,7 +100,11 @@
     // > packets, and outgoing packets are enqueued into another
     // > for transmission in that order.
     //
-    let rx_queue = device.setup_queue()?;
+    // Retain the RX IRQ so packet arrivals wake the network scheme as well
+    // as virtio-core's completion thread. A scheme-only event loop can idle forever.
+    let rx_irq = device.alloc_irq();
+    let irq_file = rx_irq.irq_handle().try_clone()?;
+    let rx_queue = device.transport.setup_queue(rx_irq)?;
     let tx_queue = device.setup_queue()?;
 
     device.transport.run_device();
@@ -124,6 +129,12 @@
         data: 0,
     })?;
 
+    event_queue.write(&syscall::Event {
+        id: irq_file.as_raw_fd() as usize,
+        flags: syscall::EVENT_READ,
+        data: 1,
+    })?;
+
     libredox::call::setrens(0, 0).expect("virtio-netd: failed to enter null namespace");
 
     scheme.tick()?;
