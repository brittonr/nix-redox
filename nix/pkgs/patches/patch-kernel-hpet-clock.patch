+++ b/src/arch/x86_shared/time.rs
@@ -1,6 +1,33 @@
 use super::device::{hpet, pit};
 use crate::sync::CleanLockToken;
+use spin::Once;
 
+struct HpetClock {
+    counter: u64,
+    nanoseconds: u128,
+    period_fs: u64,
+}
+
+static HPET_CLOCK: Once<HpetClock> = Once::new();
+
+/// Preserve the existing clock origin before reprogramming the HPET comparator.
+pub(crate) fn init_hpet_clock(
+    counter: u64,
+    comparator: u64,
+    period_fs: u64,
+    divisor: u64,
+) {
+    let mut token = unsafe { CleanLockToken::new() };
+    let offset = { *crate::time::OFFSET.read(token.token()) };
+    let elapsed = counter.saturating_sub(comparator.saturating_sub(divisor));
+    let nanoseconds = offset + (elapsed as u128 * period_fs as u128) / 1_000_000;
+    HPET_CLOCK.call_once(|| HpetClock {
+        counter,
+        nanoseconds,
+        period_fs,
+    });
+}
+
 pub fn monotonic_absolute(token: &mut CleanLockToken) -> u128 {
     // The paravirtualized TSC is already guaranteed to be monotonic, and thus doesn't need to be
     // readjusted.
@@ -8,7 +35,18 @@
