diff --git a/compiler/rustc/src/main.rs b/compiler/rustc/src/main.rs
--- a/compiler/rustc/src/main.rs
+++ b/compiler/rustc/src/main.rs
@@ -41,5 +41,25 @@
 use tikv_jemalloc_sys as _;
 
 fn main() -> ExitCode {
+    // Redox: the kernel only gives the main thread ~8KB of stack, which is not
+    // enough for rustc's session setup before the worker thread is spawned.
+    // Run the compiler on a thread with a larger stack and return its exit code.
+    #[cfg(target_os = "redox")]
+    {
+        let stack_size = 16 * 1024 * 1024; // 16 MB
+        return match std::thread::Builder::new()
+            .name("rustc-main".into())
+            .stack_size(stack_size)
+            .spawn(|| rustc_driver::main())
+        {
+            Ok(handle) => handle.join().unwrap_or(ExitCode::FAILURE),
+            Err(e) => {
+                eprintln!("rustc: failed to create main thread: {e}");
+                ExitCode::FAILURE
+            }
+        };
+    }
+
+    #[cfg(not(target_os = "redox"))]
     rustc_driver::main()
 }
