Redox uses the amd64 System V ELF backend, not Linux platform defines.
Keep configure feature checks against relibc and the POSIX pthread fallback.

--- a/configure.ac
+++ b/configure.ac
@@ -1572,6 +1572,8 @@
     [arch=arm; system=openbsd],
   [zaurus*-*-openbsd*],
     [arch=arm; system=openbsd],
+  [x86_64-*-redox*],
+    [has_native_backend=yes; arch=amd64; system=redox],
   [x86_64-*-linux*],
     [has_native_backend=yes; arch=amd64; system=linux],
   [x86_64-*-dragonfly*],
