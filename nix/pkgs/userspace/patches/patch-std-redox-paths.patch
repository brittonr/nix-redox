+#[cfg(target_os = "redox")]
+#[test]
+fn canonicalize_redox_file_scheme() {
+    assert_eq!(fs::canonicalize("/").unwrap(), Path::new("/"));
+    let cwd = env::current_dir().unwrap();
+    assert!(cwd.is_absolute());
+    assert_eq!(fs::canonicalize(".").unwrap(), cwd);
+
+    let tmpdir = tmpdir();
+    let root = fs::canonicalize(tmpdir.path()).unwrap();
+    assert!(root.is_absolute());
+    let file = root.join("canonical-file");
+    File::create(&file).unwrap();
+    assert_eq!(fs::canonicalize(&file).unwrap(), file);
+    // A normalized path remains usable on repeated canonicalization.
+    assert_eq!(fs::canonicalize(fs::canonicalize(&file).unwrap()).unwrap(), file);
+    assert!(file.is_absolute());
+}
