// ┏┓╻+╻ ╱┏┳┓┏┓┏┳┓┏┓╻
// ┃┃┃┃┗━┓╹┃╹┣┫┃┃┃┣┫┃   Read the manpage:
// ╹┗┛╹╱ ╹ ╹ ╹╹╹ ╹╹╹┗┛  $ man nixtamal-manifest
//
// Pins for building without flakes; see docs/nixtamal.md.
//
// flake.lock stays the source of truth. There is one input per flake.lock
// node, named after it, & every fresh-cmd reads that node’s revision, so
// `nixtamal refresh` (run from the repository root) re-pins to flake.lock.
// The nixtamal-pins check fails while the two disagree.
//
// Inputs are fetched at evaluation time under the store name “source”, as
// flake inputs are, so they land at the flake’s store paths & derivations stay
// identical. Redox GitLab repositories use the git kind: the archive endpoint
// behind `gitlab:` flake inputs answers non-browser clients with a challenge
// page, while Git over HTTPS works.
version "2.0.0"
default-fetch-time eval
inputs {
	// flake.nix inputs
	nixpkgs name=source {
		archive {
			url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
		}
		fresh-cmd {
			$ jq -er --arg node nixpkgs ".nodes[$node].locked.rev" flake.lock
		}
	}
	adios-flake name=source {
		archive {
			url "https://github.com/Mic92/adios-flake/archive/{{fresh_value}}.tar.gz"
		}
		fresh-cmd {
			$ jq -er --arg node adios-flake ".nodes[$node].locked.rev" flake.lock
		}
	}
	flake-parts name=source {
