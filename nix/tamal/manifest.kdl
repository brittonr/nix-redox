			$ jq -er --arg node flake-compat ".nodes[$node].locked.rev" flake.lock
		}
	}
	flake-parts_2 name=source {
		archive {
			url "https://github.com/hercules-ci/flake-parts/archive/{{fresh_value}}.tar.gz"
		}
		fresh-cmd {
