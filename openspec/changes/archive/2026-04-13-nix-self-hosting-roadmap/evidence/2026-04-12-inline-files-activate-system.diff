+fn parse_mode_string(mode: &str) -> Option<u32> {
+    let trimmed = mode.trim();
+    let trimmed = trimmed
+        .strip_prefix("0o")
+        .or_else(|| trimmed.strip_prefix('0').filter(|rest| !rest.is_empty()))
+        .unwrap_or(trimmed);
+    u32::from_str_radix(trimmed, 8).ok()
+}
+
+fn write_inline_config_file_at(root: &Path, path: &str, info: &FileInfo) -> std::io::Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+
+    let relative = path.strip_prefix('/').unwrap_or(path);
+    let full_path = root.join(relative);
+
+    if let Some(parent) = full_path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    if let Ok(meta) = std::fs::symlink_metadata(&full_path) {
+        if meta.file_type().is_symlink() {
+            std::fs::remove_file(&full_path)?;
+        }
+    }
+
+    std::fs::write(&full_path, info.text.as_deref().unwrap_or(""))?;
+    if let Some(mode) = parse_mode_string(&info.mode) {
+        let _ = std::fs::set_permissions(&full_path, std::fs::Permissions::from_mode(mode));
+    }
+
+    Ok(())
+}
