# Direct-header hosts (Cloudflare Pages, etc.) apply these rules natively.
# GitHub Pages ignores this file; coi-serviceworker.js is a bounded fallback.
# Use "! Cache-Control" before overrides so Cloudflare Pages replaces rather
# than concatenates the Cache-Control header from /*.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

/channel.json
  ! Cache-Control
  Cache-Control: no-store

/manifest.json
  ! Cache-Control
  Cache-Control: no-store

/revisions/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/revisions/:revision/coi-serviceworker.js
  ! Cache-Control
  Cache-Control: no-store
